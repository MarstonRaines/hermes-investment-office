# ============================================================
# 环境变量示例（复制为 .env 使用；真实 .env 禁止进 git —— .gitignore）
# TS-05 §7：token/key 只走环境变量；ADR-004 D5：绑定/URL 配置化
# ============================================================

# 服务绑定（v0.1 默认本地单机；远程化改 bind_host，见 ADR-004）
HERMES_BIND_HOST=127.0.0.1
HERMES_BIND_PORT=8000
HERMES_BASE_URL=http://127.0.0.1:8000

# 认证预留（v0.1 关闭；远程化激活，ADR-004 D3）
HERMES_AUTH_ENABLED=false
# HERMES_BACKEND_TOKEN=请设置随机长 token

# Backend 每日数据与计算任务（最终本地产品形态）
HERMES_SCHEDULER_ENABLED=true
HERMES_SCHEDULER_TIMEZONE=Asia/Shanghai
HERMES_SCHEDULER_HOUR=7
HERMES_SCHEDULER_MINUTE=30

# 本机数据库。只需把两处 change-me-local-db-password 替换成同一个随机口令。
# 正式 compose 不向宿主机映射 PostgreSQL 端口；127.0.0.1 仅供宿主机测试工具使用。
HERMES_POSTGRES_USER=hermes
HERMES_POSTGRES_PASSWORD=change-me-local-db-password
HERMES_POSTGRES_DB=hermes
HERMES_DB_URL=postgresql+psycopg2://hermes:change-me-local-db-password@127.0.0.1:5432/hermes

# 外部 Provider（M0.5 Spike 后启用；真实 token 填 .env，不填本文件）
HERMES_TUSHARE_TOKEN=
HERMES_FRED_API_KEY=

# 可选：由用户自行维护的 HTTP 代理；Docker 访问宿主机时使用 host.docker.internal。
# HERMES_EXTERNAL_PROXY=http://host.docker.internal:7892
HERMES_EXTERNAL_PROXY=
