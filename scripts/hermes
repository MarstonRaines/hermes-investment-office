#!/usr/bin/env bash
set -euo pipefail

HERMES_PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HERMES_ENV_FILE="${HERMES_PROJECT_ROOT}/backend/.env"
HERMES_AGENT_BIN="${HERMES_AGENT_BIN:-$(command -v hermes || true)}"
HERMES_CHAT_PORT="${HERMES_CHAT_PORT:-9119}"
HERMES_CHAT_RUNTIME_DIR="${TMPDIR:-/tmp}/hermes-investment-office"
HERMES_CHAT_PID_FILE="${HERMES_CHAT_RUNTIME_DIR}/dashboard.pid"
HERMES_CHAT_LOG="${HERMES_CHAT_LOG:-${HOME}/.hermes/logs/investment-office-dashboard.log}"
HERMES_CHAT_LAUNCHD_LABEL="com.hermes.investment-office.chat"

if [[ -f "${HERMES_ENV_FILE}" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "${HERMES_ENV_FILE}"
  set +a
fi

export HERMES_AGENT_CWD="${HERMES_AGENT_CWD:-${HERMES_PROJECT_ROOT}}"

if [[ -z "${HERMES_POSTGRES_PASSWORD:-}" ]]; then
  if [[ -z "${HERMES_DB_URL:-}" ]]; then
    echo "缺少 HERMES_DB_URL 或 HERMES_POSTGRES_PASSWORD" >&2
    exit 1
  fi
  HERMES_POSTGRES_PASSWORD="$(python3 -c 'import os, urllib.parse; print(urllib.parse.unquote(urllib.parse.urlsplit(os.environ["HERMES_DB_URL"]).password or ""))')"
  export HERMES_POSTGRES_PASSWORD
fi

compose() {
  docker compose --project-directory "${HERMES_PROJECT_ROOT}" \
    -f "${HERMES_PROJECT_ROOT}/docker-compose.yml" "$@"
}

wait_for_backend() {
  local attempt
  for attempt in {1..60}; do
    if curl -fsS http://127.0.0.1:8000/healthz >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  echo "Backend 在 60 秒内未就绪，请运行 ./scripts/hermes logs" >&2
  return 1
}

hermes_chat_ready() {
  curl -fsS "http://127.0.0.1:${HERMES_CHAT_PORT}/api/health" >/dev/null 2>&1
}

start_hermes_chat() {
  local attempt pid
  if hermes_chat_ready; then
    return 0
  fi
  if [[ -z "${HERMES_AGENT_BIN}" || ! -x "${HERMES_AGENT_BIN}" ]]; then
    echo "未找到 Hermes Agent 命令，问 Hermes 页面将暂不可用。" >&2
    return 1
  fi

  mkdir -p "${HERMES_CHAT_RUNTIME_DIR}" "$(dirname "${HERMES_CHAT_LOG}")"
  local -a hermes_chat_args=(
    dashboard --host 127.0.0.1 --port "${HERMES_CHAT_PORT}" --no-open
  )
  if [[ -f "${HOME}/.hermes/hermes-agent/hermes_cli/web_dist/index.html" ]]; then
    hermes_chat_args+=(--skip-build)
  fi

  if [[ "$(uname -s)" == "Darwin" ]]; then
    launchctl remove "${HERMES_CHAT_LAUNCHD_LABEL}" >/dev/null 2>&1 || true
    launchctl submit -l "${HERMES_CHAT_LAUNCHD_LABEL}" \
      -o "${HERMES_CHAT_LOG}" -e "${HERMES_CHAT_LOG}" -- \
      /usr/bin/env "HERMES_AGENT_CWD=${HERMES_AGENT_CWD}" \
      "${HERMES_AGENT_BIN}" "${hermes_chat_args[@]}"
    pid="$(launchctl print "gui/$(id -u)/${HERMES_CHAT_LAUNCHD_LABEL}" 2>/dev/null \
      | awk '/pid =/{print $3; exit}')"
  elif [[ -f "${HOME}/.hermes/hermes-agent/hermes_cli/web_dist/index.html" ]]; then
    nohup "${HERMES_AGENT_BIN}" dashboard \
      --host 127.0.0.1 --port "${HERMES_CHAT_PORT}" --no-open --skip-build \
      >>"${HERMES_CHAT_LOG}" 2>&1 &
    pid=$!
  else
    nohup "${HERMES_AGENT_BIN}" dashboard \
      --host 127.0.0.1 --port "${HERMES_CHAT_PORT}" --no-open \
      >>"${HERMES_CHAT_LOG}" 2>&1 &
    pid=$!
  fi
  if [[ "${pid:-}" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "${pid}" >"${HERMES_CHAT_PID_FILE}"
  fi

  for attempt in {1..60}; do
    if hermes_chat_ready; then
      return 0
    fi
    if [[ "${pid:-}" =~ ^[0-9]+$ ]] && ! kill -0 "${pid}" 2>/dev/null; then
      break
    fi
    sleep 1
  done
  echo "Hermes 对话服务未能启动，请运行 ./scripts/hermes logs chat" >&2
  return 1
}

stop_hermes_chat() {
  local pid command_line attempt
  if [[ "$(uname -s)" == "Darwin" ]] \
    && launchctl print "gui/$(id -u)/${HERMES_CHAT_LAUNCHD_LABEL}" >/dev/null 2>&1; then
    launchctl remove "${HERMES_CHAT_LAUNCHD_LABEL}"
    rm -f "${HERMES_CHAT_PID_FILE}"
    return 0
  fi
  if [[ ! -f "${HERMES_CHAT_PID_FILE}" ]]; then
    return 0
  fi
  IFS= read -r pid <"${HERMES_CHAT_PID_FILE}" || true
  if [[ "${pid}" =~ ^[0-9]+$ ]] && kill -0 "${pid}" 2>/dev/null; then
    command_line="$(ps -p "${pid}" -o command= 2>/dev/null || true)"
    if [[ "${command_line}" == *"hermes"* && "${command_line}" == *"dashboard"* && "${command_line}" == *"--port ${HERMES_CHAT_PORT}"* ]]; then
      kill "${pid}"
      for attempt in {1..10}; do
        if ! kill -0 "${pid}" 2>/dev/null; then
          break
        fi
        sleep 1
      done
    fi
  fi
  rm -f "${HERMES_CHAT_PID_FILE}"
}

case "${1:-status}" in
  start)
    if ! start_hermes_chat; then
      echo "警告：核心 Dashboard 仍会启动，但“问 Hermes”将显示明确故障状态。" >&2
    fi
    compose up -d --build
    wait_for_backend
    echo "Hermes 已启动：http://127.0.0.1:8501"
    ;;
  stop)
    stop_hermes_chat
    compose down
    ;;
  restart)
    stop_hermes_chat
    if ! start_hermes_chat; then
      echo "警告：核心 Dashboard 仍会重启，但“问 Hermes”将显示明确故障状态。" >&2
    fi
    compose up -d --build --force-recreate
    wait_for_backend
    echo "Hermes 已重启：http://127.0.0.1:8501"
    ;;
  status)
    compose ps
    if hermes_chat_ready; then
      echo "Hermes 对话服务：已就绪（http://127.0.0.1:${HERMES_CHAT_PORT}）"
    else
      echo "Hermes 对话服务：未连接"
    fi
    ;;
  logs)
    if [[ "${2:-}" == "chat" ]]; then
      if [[ -f "${HERMES_CHAT_LOG}" ]]; then
        tail -n 200 "${HERMES_CHAT_LOG}"
      else
        echo "尚无 Hermes 对话服务日志：${HERMES_CHAT_LOG}"
      fi
    elif [[ -n "${2:-}" ]]; then
      compose logs --tail=200 "$2"
    else
      compose logs --tail=200
    fi
    ;;
  bootstrap)
    docker exec hermes-backend python -m app.cli bootstrap
    ;;
  refresh)
    docker exec hermes-backend python -m app.cli refresh
    ;;
  backup)
    "${HERMES_PROJECT_ROOT}/scripts/backup.sh"
    ;;
  open)
    open http://127.0.0.1:8501
    ;;
  *)
    echo "用法: ./scripts/hermes {start|stop|restart|status|logs [service|chat]|bootstrap|refresh|backup|open}" >&2
    exit 2
    ;;
esac
